CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000

# PSRAM (display buffers); 200 MHz needs the experimental flag on P4
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# M5Stack Tab5 BSP (values from the esp-bsp Tab5 examples)
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=n
CONFIG_CAM_CTRL_SPI_ENABLE=n

# LVGL 9
CONFIG_LV_CONF_SKIP=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# Wi-Fi through the on-board ESP32-C6 (esp_wifi_remote + esp_hosted 2.x over SDIO).
# The Tab5 board option sets the pins from the M5Stack docs: CLK 12, CMD 13, D0-D3 11/10/9/8, C6 reset 15 (active low).
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP32P4_TAB5_C6_BOARD=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# The Tab5 board option defaults to active-low, which holds this unit's C6 (board v1, ILI9881C) in reset
# (sdmmc send_op_cond 0x107). Active-high leaves GPIO15 high, as the working Arduino core does.
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
