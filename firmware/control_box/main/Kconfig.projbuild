menu "Control box"
    config HUB_IP
        string "mavlink-router host IP"
        default "192.168.2.134"
    config HUB_PORT
        int "mavlink-router UDP server port"
        default 14560
    config MAV_SYSID
        int "Own MAVLink system ID (must match SYSID_MYGCS on the vehicle)"
        default 255
    config MAV_COMPID
        int "Own MAVLink component ID"
        default 25
    config MQTT_BROKER_URI
        string "MQTT broker URI (shared vehicle selection)"
        default "mqtt://192.168.2.134:1883"
    config MQTT_USER
        string "MQTT username"
        default "ctrlbox"
    config MQTT_PASSWORD
        string "MQTT password (set via menuconfig; sdkconfig is not committed)"
        default ""
endmenu
